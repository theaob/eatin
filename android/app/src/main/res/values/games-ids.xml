<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play Games Services IDs.

     Until app_id is a real project ID (digits only), Play Games stays off and
     the app behaves exactly as before. To turn it on, open Play Console >
     Play Games Services > Setup and management > Configuration, press
     "Get resources", copy the Android XML and paste it over this whole file.

     The game finds achievements and leaderboards by name (MainActivity.Games
     looks up "achievement_<key>" and "leaderboard_<key>"), so create them in
     Play Console with exactly the names in android/README.md. Play Console turns
     a name like "Black hole" into achievement_black_hole. An empty or missing
     entry is skipped. -->
<resources>
